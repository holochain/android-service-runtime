{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "holochain-runtime-example",
  "version": "0.1.0",
  "identifier": "org.holochain.runtimeexample",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui install && npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
